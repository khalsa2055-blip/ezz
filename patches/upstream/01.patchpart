@@ -0,0 +1,34 @@
+# AyuGram iOS Port Status — 1.3.0
+
+## Implemented
+- Per-account AyuGram settings persistence
+- Ghost Mode policy and hooks for read, story-read, presence, upload-progress and message-view paths
+- Deleted-message capture before Postbox deletion
+- Incoming edit-history capture before Postbox replacement
+- Postbox-native AyuGram history state with duplicate suppression and scoped clearing
+- Regex filter engine and chat history filter gate
+- Message Shot context-menu action for text and media-only messages
+- Display-only Zalgo / bidi sanitizer
+- Custom edited mark setting
+- Translation provider selector setting
+- Provider-backed Google/Yandex translation service through Telegram's optional internal translation hook
+- Message bubble tail visibility control
+- Message-shot appearance controls surfaced in AyuGram settings
+
+## Not yet validated in this environment
+- Full Xcode build against a selected iOS SDK
+- Device installation / signing / IPA archive
+- Live network behavior on physical iOS devices
+- Provider rate limits and endpoint availability
+- Full-fidelity media rasterization for Message Shot
+- Visual regression testing across all Telegram bubble layouts
+
+## 1.3.0
+
+- Integrated regex filters into TelegramUI text rendering for incoming messages.
+- Preserves outgoing messages and keeps original Telegram message text untouched.
+- Applies per-dialog rules before shared rules and respects shared-filter exclusions.
+- Restricts chat filtering unless `filtersEnabledInChats` is enabled; broadcast channels remain eligible.
+- Compiles regular expressions once per account/settings snapshot and reuses the engine during message rendering.
+
+- Corrected filter eligibility in chat history: outgoing messages are preserved, and shared filters apply to broadcast channels.
diff -ruN /mnt/data/repo_base/submodules/AyuGramIOS/Sources/AyuGramCaptureService.swift /mnt/data/repo_mod/submodules/AyuGramIOS/Sources/AyuGramCaptureService.swift
--- a/submodules/AyuGramIOS/Sources/AyuGramCaptureService.swift	1970-01-01 00:00:00.000000000 +0000
+++ b/submodules/AyuGramIOS/Sources/AyuGramCaptureService.swift	2026-09-30 19:02:47.000000000 +0000
@@ -0,0 +1,42 @@
+import Foundation
+import Postbox
+
+/// Entry points used by TelegramCore just before a message is deleted or
+/// replaced by an edit. The snapshot is created synchronously while the
+/// Postbox transaction still has the original message, while persistence is
+/// performed asynchronously so the Telegram transaction is not blocked.
+public enum AyuGramCaptureService {
+    public static func captureDeleted(transaction: Transaction, messages: [Message], accountID: Int64) {
+        guard !messages.isEmpty else {
+            return
+        }
+        let settingsStore = try? AyuGramRuntime.makeSettingsStore(accountID: accountID)
+        guard settingsStore?.settings.saveDeletedMessages == true else {
+            return
+        }
+
+        let snapshots = messages.map {
+            AyuGramPostboxBridge.snapshot(
+                message: $0,
+                accountID: accountID,
+                isDeleted: true
+            )
+        }
+        _ = AyuGramPostboxHistoryStore.appendDeleted(transaction: transaction, messages: snapshots)
+    }
+
+    public static func captureEdited(transaction: Transaction, message: Message, accountID: Int64, editDate: Int32) {
+        let settingsStore = try? AyuGramRuntime.makeSettingsStore(accountID: accountID)
+        guard settingsStore?.settings.saveMessagesHistory == true else {
+            return
+        }
+
+        let snapshot = AyuGramPostboxBridge.snapshot(
+            message: message,
+            accountID: accountID,
+            isDeleted: false,
+            editDate: editDate
+        )
+        _ = AyuGramPostboxHistoryStore.appendEdited(transaction: transaction, messages: [snapshot])
+    }
+}
diff -ruN /mnt/data/repo_base/submodules/AyuGramIOS/Sources/AyuGramPostboxBridge.swift /mnt/data/repo_mod/submodules/AyuGramIOS/Sources/AyuGramPostboxBridge.swift
--- a/submodules/AyuGramIOS/Sources/AyuGramPostboxBridge.swift	1970-01-01 00:00:00.000000000 +0000
+++ b/submodules/AyuGramIOS/Sources/AyuGramPostboxBridge.swift	2026-09-30 23:04:25.000000000 +0000
@@ -0,0 +1,31 @@
+import Foundation
+import Postbox
+
+/// Adapts Telegram-iOS Postbox.Message to Ayu's portable history model.
+/// This does not mutate Postbox and is intended to run before a message
+/// is removed or replaced by a newer revision.
+public enum AyuGramPostboxBridge {
+    public static func snapshot(
+        message: Message,
+        accountID: Int64,
+        isDeleted: Bool,
+        editDate: Int32 = 0
+    ) -> AyuMessage {
+        let authorID = message.author?.id.toInt64() ?? 0
+        return AyuMessage(
+            fakeID: 0,
+            userID: accountID,
+            dialogID: message.id.peerId.toInt64(),
+            peerID: message.id.peerId.toInt64(),
+            fromID: authorID,
+            topicID: message.threadId ?? 0,
+            messageID: message.id.id,
+            date: message.timestamp,
+            editDate: editDate,
+            text: message.text,
+            mediaPath: nil,
+            mimeType: nil,
+            isDeleted: isDeleted
+        )
+    }
+}
