+load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library")
+
+swift_library(
+    name = "AyuGramIOS",
+    module_name = "AyuGramIOS",
+    srcs = glob([
+        "Sources/**/*.swift",
+    ]),
+    copts = [
+        "-warnings-as-errors",
+    ],
+    deps = [
+        "//submodules/Postbox:Postbox",
+    ],
+    visibility = [
+        "//visibility:public",
+    ],
+)
