diff -ruN /mnt/data/repo_base/Telegram/Telegram-iOS/AyuGramAppIntegration.swift /mnt/data/repo_mod/Telegram/Telegram-iOS/AyuGramAppIntegration.swift
--- a/Telegram/Telegram-iOS/AyuGramAppIntegration.swift	1970-01-01 00:00:00.000000000 +0000
+++ b/Telegram/Telegram-iOS/AyuGramAppIntegration.swift	2026-09-30 23:04:25.000000000 +0000
@@ -0,0 +1,18 @@
+import Foundation
+import AyuGramIOS
+
+/// App-level integration surface. Telegram account/session code should call
+/// `makeForAccount(accountID:)` when an account becomes active.
+enum AyuGramAppIntegration {
+    static func settings(forAccountID accountID: Int64) -> AyuSettings? {
+        return AyuGramRuntime.settings(accountID: accountID)
+    }
+
+    static func updateSettings(forAccountID accountID: Int64, update: (inout AyuSettings) -> Void) -> Bool {
+        guard let store = try? AyuGramRuntime.cachedSettingsStore(accountID: accountID), (try? store.update(update)) != nil else {
+            return false
+        }
+        return true
+    }
+
+}
