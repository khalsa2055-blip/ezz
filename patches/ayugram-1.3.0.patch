@@ -0,0 +1,42 @@
+import Foundation
+import Postbox
+
+/// Entry points used by TelegramCore just before a message is deleted or
+/// replaced by an edit. The snapshot is created synchronously while the
+/// Postbox transaction still has the original message, while persistence is
+/// performed asynchronously so the Telegram transaction is not blocked.
+public enum AyuGramCaptureService {
+    public static func captureDeleted(transaction: Transaction, messages: [Message], accountID: Int64) {
+        guard !messages.isEmpty else {
+            return
+        }
+        let settingsStore = try? AyuGramRuntime.makeSettingsStore(accountID: accountID)
+        guard settingsStore?.settings.saveDeletedMessages == true else {
+            return
+        }
+
+        let snapshots = messages.map {
+            AyuGramPostboxBridge.snapshot(
+                message: $0,
+                accountID: accountID,
+                isDeleted: true
+            )
+        }
+        _ = AyuGramPostboxHistoryStore.appendDeleted(transaction: transaction, messages: snapshots)
+    }
+
+    public static func captureEdited(transaction: Transaction, message: Message, accountID: Int64, editDate: Int32) {
+        let settingsStore = try? AyuGramRuntime.makeSettingsStore(accountID: accountID)
+        guard settingsStore?.settings.saveMessagesHistory == true else {
+            return
+        }
+
+        let snapshot = AyuGramPostboxBridge.snapshot(
+            message: message,
+            accountID: accountID,
+            isDeleted: false,
+            editDate: editDate
+        )
+        _ = AyuGramPostboxHistoryStore.appendEdited(transaction: transaction, messages: [snapshot])
+    }
+}
diff --git a/submodules/AyuGramIOS/Sources/AyuGramPostboxBridge.swift b/submodules/AyuGramIOS/Sources/AyuGramPostboxBridge.swift
