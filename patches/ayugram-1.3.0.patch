--- /dev/null
+++ b/submodules/AyuGramIOS/Sources/RegexFilters.swift
@@ -0,0 +1,95 @@
+import Foundation
+
+public struct RegexFilter: Codable, Equatable, Identifiable, Sendable {
+    public let id: UUID
+    public var text: String
+    public var enabled: Bool
+    public var reversed: Bool
+    public var caseInsensitive: Bool
+    public var dialogID: Int64?
+
+    public init(
+        id: UUID = UUID(),
+        text: String,
+        enabled: Bool = true,
+        reversed: Bool = false,
+        caseInsensitive: Bool = false,
+        dialogID: Int64? = nil
+    ) {
+        self.id = id
+        self.text = text
+        self.enabled = enabled
+        self.reversed = reversed
+        self.caseInsensitive = caseInsensitive
+        self.dialogID = dialogID
+    }
+}
+
+public struct RegexFilterExclusion: Codable, Equatable, Hashable, Sendable {
+    public let dialogID: Int64
+    public let filterID: UUID
+
+    public init(dialogID: Int64, filterID: UUID) {
+        self.dialogID = dialogID
+        self.filterID = filterID
+    }
+}
+
+public final class RegexFilterEngine: @unchecked Sendable {
+    private struct CompiledFilter {
+        let filter: RegexFilter
+        let regex: NSRegularExpression?
+    }
+
+    private var filters: [CompiledFilter]
+    private var exclusions: Set<RegexFilterExclusion>
+    private let lock = NSLock()
+
+    public init(filters: [RegexFilter] = [], exclusions: Set<RegexFilterExclusion> = []) {
+        self.filters = RegexFilterEngine.compile(filters)
+        self.exclusions = exclusions
+    }
+
+    public func replace(filters: [RegexFilter], exclusions: Set<RegexFilterExclusion>) {
+        lock.lock(); defer { lock.unlock() }
+        self.filters = Self.compile(filters)
+        self.exclusions = exclusions
+    }
+
+    /// Mirrors AyuGram's rule: a normal matching rule hides, while a reversed
+    /// rule hides when it does NOT match. Per-dialog rules are checked first.
+    public func isFiltered(text: String, dialogID: Int64, includeShared: Bool = true) -> Bool {
+        guard !text.isEmpty else { return false }
+        lock.lock(); let snapshotFilters = filters; let snapshotExclusions = exclusions; lock.unlock()
+
+        for compiled in snapshotFilters where compiled.filter.enabled && compiled.filter.dialogID == dialogID {
+            if matches(compiled, text: text) { return true }
+        }
+
+        guard includeShared else { return false }
+
+        for compiled in snapshotFilters where compiled.filter.enabled && compiled.filter.dialogID == nil {
+            let excluded = snapshotExclusions.contains(.init(dialogID: dialogID, filterID: compiled.filter.id))
+            guard !excluded else { continue }
+            if matches(compiled, text: text) { return true }
+        }
+        return false
+    }
+
+    private static func compile(_ filters: [RegexFilter]) -> [CompiledFilter] {
+        filters.map { filter in
+            let options: NSRegularExpression.Options = filter.caseInsensitive ? [.caseInsensitive] : []
+            return CompiledFilter(
+                filter: filter,
+                regex: try? NSRegularExpression(pattern: filter.text, options: options)
+            )
+        }
+    }
+
+    private func matches(_ compiled: CompiledFilter, text: String) -> Bool {
+        guard let regex = compiled.regex else { return false }
+        let range = NSRange(text.startIndex..<text.endIndex, in: text)
+        let found = regex.firstMatch(in: text, options: [], range: range) != nil
+        return compiled.filter.reversed ? !found : found
+    }
+}
