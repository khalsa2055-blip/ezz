diff --git a/submodules/TranslateUI/Sources/AyuGramTranslationService.swift b/submodules/TranslateUI/Sources/AyuGramTranslationService.swift
new file mode 100644
--- /dev/null
+++ b/submodules/TranslateUI/Sources/AyuGramTranslationService.swift
@@ -0,0 +1,169 @@
+import Foundation
+import SwiftSignalKit
+import TelegramCore
+import AyuGramIOS
+
+/// Routes Telegram's optional local translation hook through the provider chosen
+/// in AyuGram settings. Telegram remains the fallback when the selected provider
+/// is not an external provider.
+public final class AyuGramTranslationService: ExperimentalInternalTranslationService {
+    private let accountID: Int64
+
+    public init(accountID: Int64) {
+        self.accountID = accountID
+    }
+
+    public func translate(texts: [AnyHashable: String], fromLang: String, toLang: String) -> Signal<[AnyHashable: String]?, NoError> {
+        guard let settings = AyuGramRuntime.settings(accountID: accountID) else {
+            return .single(nil)
+        }
+
+        switch settings.translationProvider {
+        case .telegram, .native:
+            return .single(nil)
+        case .google:
+            return translateEach(texts: texts, fromLang: fromLang, toLang: toLang, provider: .google)
+        case .yandex:
+            return translateEach(texts: texts, fromLang: fromLang, toLang: toLang, provider: .yandex)
+        }
+    }
+
+    private enum Provider {
+        case google
+        case yandex
+    }
+
+    private func translateEach(
+        texts: [AnyHashable: String],
+        fromLang: String,
+        toLang: String,
+        provider: Provider
+    ) -> Signal<[AnyHashable: String]?, NoError> {
+        Signal { subscriber in
+            if texts.isEmpty || toLang.isEmpty {
+                subscriber.putNext([:])
+                subscriber.putCompletion()
+                return EmptyDisposable
+            }
+
+            let lock = NSLock()
+            var results: [AnyHashable: String] = [:]
+            var pending = texts.count
+            var cancelled = false
+            var tasks: [URLSessionDataTask] = []
+
+            func finishOne(key: AnyHashable, value: String?) {
+                lock.lock()
+                if cancelled {
+                    lock.unlock()
+                    return
+                }
+                if let value, !value.isEmpty {
+                    results[key] = value
+                }
+                pending -= 1
+                let done = pending == 0
+                let finalResults = results
+                lock.unlock()
+
+                if done {
+                    subscriber.putNext(finalResults)
+                    subscriber.putCompletion()
+                }
+            }
+
+            for (key, value) in texts {
+                let task: URLSessionDataTask
+                switch provider {
+                case .google:
+                    guard let url = Self.googleURL(text: value, fromLang: fromLang, toLang: toLang) else {
+                        finishOne(key: key, value: nil)
+                        continue
+                    }
+                    var request = URLRequest(url: url)
+                    request.httpMethod = "GET"
+                    request.setValue(Self.userAgent, forHTTPHeaderField: "User-Agent")
+                    task = URLSession.shared.dataTask(with: request) { data, response, _ in
+                        guard let data, (response as? HTTPURLResponse)?.statusCode == 200 else {
+                            finishOne(key: key, value: nil)
+                            return
+                        }
+                        finishOne(key: key, value: Self.parseGoogle(data: data))
+                    }
+                case .yandex:
+                    guard let url = Self.yandexURL(text: value, fromLang: fromLang, toLang: toLang) else {
+                        finishOne(key: key, value: nil)
+                        continue
+                    }
+                    var request = URLRequest(url: url)
+                    request.httpMethod = "GET"
+                    request.setValue("ru.yandex.translate/21.15.4.21402814 (iPhone; iOS 18)", forHTTPHeaderField: "User-Agent")
+                    task = URLSession.shared.dataTask(with: request) { data, response, _ in
+                        guard let data, (response as? HTTPURLResponse)?.statusCode == 200 else {
+                            finishOne(key: key, value: nil)
+                            return
+                        }
+                        finishOne(key: key, value: Self.parseYandex(data: data))
+                    }
+                }
+                tasks.append(task)
+                task.resume()
+            }
+
+            return ActionDisposable {
+                lock.lock()
+                cancelled = true
+                lock.unlock()
+                for task in tasks {
+                    task.cancel()
+                }
+            }
+        }
+    }
+
+    private static let userAgent = "Mozilla/5.0 (iPhone; CPU iPhone OS 18_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/18.0 Mobile/15E148 Safari/604.1"
+
+    private static func googleURL(text: String, fromLang: String, toLang: String) -> URL? {
+        var components = URLComponents(string: "https://translate.googleapis.com/translate_a/single")
+        components?.queryItems = [
+            URLQueryItem(name: "client", value: "gtx"),
+            URLQueryItem(name: "sl", value: fromLang.isEmpty ? "auto" : fromLang),
+            URLQueryItem(name: "tl", value: toLang),
+            URLQueryItem(name: "dt", value: "t"),
+            URLQueryItem(name: "ie", value: "UTF-8"),
+            URLQueryItem(name: "oe", value: "UTF-8"),
+            URLQueryItem(name: "q", value: text)
+        ]
+        return components?.url
+    }
+
+    private static func yandexURL(text: String, fromLang: String, toLang: String) -> URL? {
+        var components = URLComponents(string: "https://translate.yandex.net/api/v1/tr.json/translate")
+        let lang = fromLang.isEmpty ? toLang : "\(fromLang)-\(toLang)"
+        components?.queryItems = [
+            URLQueryItem(name: "srv", value: "iphone"),
+            URLQueryItem(name: "lang", value: lang),
+            URLQueryItem(name: "text", value: text)
+        ]
+        return components?.url
+    }
+
+    private static func parseGoogle(data: Data) -> String? {
+        guard let root = try? JSONSerialization.jsonObject(with: data) as? [Any],
+              let blocks = root.first as? [Any] else { return nil }
+        var output = ""
+        for block in blocks {
+            if let item = block as? [Any], let text = item.first as? String {
+                output += text
+            }
+        }
+        return output.isEmpty ? nil : output
+    }
+
+    private static func parseYandex(data: Data) -> String? {
+        guard let object = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+              let values = object["text"] as? [String] else { return nil }
+        let result = values.joined()
+        return result.isEmpty ? nil : result
+    }
+}
