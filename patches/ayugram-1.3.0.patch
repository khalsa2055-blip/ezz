+    public var showChannelReactions = true
+    public var showGroupReactions = true
+    public var showPrivateChatReactions = true
+    public var appIcon = ""
+    public var simpleQuotesAndReplies = false
+    public var hideFastShare = false
+    public var replaceBottomInfoWithIcons = true
+    public var deletedMark = "🧹"
+    public var editedMark = ""
+    public var unlimitedRecentStickers = false
+    public var showAttachButtonInMessageField = true
+    public var showCommandsButtonInMessageField = true
+    public var showEmojiButtonInMessageField = true
+    public var showMicrophoneButtonInMessageField = true
+    public var showAutoDeleteButtonInMessageField = true
+    public var showGiftButtonInMessageField = true
+    public var showAiEditorButtonInMessageField = true
+    public var showAttachPopup = true
+    public var showEmojiPopup = true
+    public var showMessageSeconds = false
+    public var showMessageShot = true
+    public var filterZalgo = false
+    public var stickerConfirmation = false
+    public var gifConfirmation = false
+    public var voiceConfirmation = false
+    public var roundConfirmation = false
+    public var translationProvider: TranslationProvider = .telegram
+    public var adaptiveCoverColor = true
+    public var improveLinkPreviews = false
+    public var crashReporting = true
+    public var avatarCorners = 23
+    public var singleCornerRadius = false
+    public var messageBubbleRadius = 16
+    public var peerIDDisplay: PeerIDDisplay = .botAPI
+    public var channelBottomButton: ChannelBottomButton = .discussWithFallback
+    public var quickAdminShortcuts = true
+
+    public var showReactionsPanelInContextMenu: ContextMenuVisibility = .visible
+    public var showViewsPanelInContextMenu: ContextMenuVisibility = .visible
+    public var showHideMessageInContextMenu: ContextMenuVisibility = .hidden
+    public var showUserMessagesInContextMenu: ContextMenuVisibility = .visibleWithModifier
+    public var showMessageDetailsInContextMenu: ContextMenuVisibility = .visibleWithModifier
+    public var showRepeatMessageInContextMenu: ContextMenuVisibility = .hidden
+    public var showAddFilterInContextMenu: ContextMenuVisibility = .visible
+
+    public var messageShot = MessageShotSettings()
+    public var ghostByAccount: [Int64: GhostModeSettings] = [:]
+    public var regexFilters: [RegexFilter] = []
+    public var regexFilterExclusions: Set<RegexFilterExclusion> = []
+
+    public init() {}
+
+    public func ghostSettings(for accountID: Int64) -> GhostModeSettings {
+        ghostByAccount[accountID] ?? GhostModeSettings()
+    }
+
+    public mutating func updateGhostSettings(for accountID: Int64, _ update: (inout GhostModeSettings) -> Void) {
+        var settings = ghostSettings(for: accountID)
+        update(&settings)
+        ghostByAccount[accountID] = settings
