+public enum AyuMessageShotRenderer {
+    public static func render(message: Message, settings: AyuSettings) -> UIImage? {
+        let shotSettings = settings.messageShot
+        let maxWidth: CGFloat = 560.0
+        let horizontalPadding: CGFloat = 24.0
+        let cardInset: CGFloat = 8.0
+        let titleFont = UIFont.systemFont(ofSize: 13.0, weight: .semibold)
+        let bodyFont = UIFont.systemFont(ofSize: 17.0)
+        let metaFont = UIFont.systemFont(ofSize: 12.0)
+        let date = Date(timeIntervalSince1970: TimeInterval(message.timestamp))
+        let formatter = DateFormatter()
+        formatter.dateStyle = .medium
+        formatter.timeStyle = settings.showMessageSeconds ? .medium : .short
+        let dateText = formatter.string(from: date)
+
+        var lines: [String] = []
+        if !message.text.isEmpty {
+            lines.append(message.text)
+        }
+        if !message.media.isEmpty {
+            for media in message.media {
+                if media is TelegramMediaImage {
+                    lines.append("📷 Photo")
+                } else if let file = media as? TelegramMediaFile {
+                    if file.mimeType.hasPrefix("video/") {
+                        lines.append("🎬 Video")
+                    } else if file.mimeType.hasPrefix("audio/") {
+                        lines.append("🎵 Audio")
+                    } else if file.mimeType == "image/gif" {
+                        lines.append("🎞 GIF")
+                    } else if let name = file.indexableText, !name.isEmpty {
+                        lines.append("📎 \(name)")
+                    } else {
+                        lines.append("📎 File")
+                    }
+                } else {
+                    lines.append("📎 Media")
+                }
+            }
+        }
+        if lines.isEmpty {
+            lines = ["(empty message)"]
+        }
+
+        var reactionLine: String?
+        if shotSettings.showReactions,
+           let reactions = message.attributes.compactMap({ $0 as? ReactionsMessageAttribute }).first,
+           !reactions.reactions.isEmpty {
+            let summary = reactions.reactions.prefix(6).compactMap { reaction -> String? in
+                switch reaction.value {
+                case let .builtin(value):
+                    return "\(value) \(reaction.count)"
+                case .custom:
+                    return "◉ \(reaction.count)"
+                case .stars:
+                    return "⭐️ \(reaction.count)"
+                }
+            }.joined(separator: "   ")
+            if !summary.isEmpty {
+                reactionLine = summary
+            }
+        }
+
+        let availableWidth = maxWidth - horizontalPadding * 2.0
+        var contentHeight: CGFloat = 0.0
+        var measured: [(String, CGFloat)] = []
+        for line in lines {
+            let rect = NSString(string: line).boundingRect(
+                with: CGSize(width: availableWidth, height: 20000.0),
+                options: [.usesLineFragmentOrigin, .usesFontLeading],
+                attributes: [.font: bodyFont],
+                context: nil
+            )
+            measured.append((line, max(24.0, rect.height)))
+            contentHeight += max(24.0, rect.height) + 6.0
+        }
+        if let reactionLine {
+            let rect = NSString(string: reactionLine).boundingRect(
+                with: CGSize(width: availableWidth, height: 200.0),
+                options: [.usesLineFragmentOrigin, .usesFontLeading],
+                attributes: [.font: metaFont],
+                context: nil
+            )
+            contentHeight += rect.height + 10.0
+        }
+
+        let headerHeight: CGFloat = shotSettings.showHeaderDecorations ? 38.0 : 0.0
+        let footerHeight: CGFloat = shotSettings.showDate ? 26.0 : 0.0
+        let height = max(112.0, contentHeight + headerHeight + footerHeight + horizontalPadding * 2.0)
+        let renderer = UIGraphicsImageRenderer(size: CGSize(width: maxWidth, height: height))
+        return renderer.image { context in
+            let bounds = CGRect(origin: .zero, size: context.format.bounds.size)
+            UIColor.systemBackground.setFill()
+            context.cgContext.fill(bounds)
+
+            if shotSettings.showBackground {
+                let background = bounds.insetBy(dx: cardInset, dy: cardInset)
+                UIBezierPath(roundedRect: background, cornerRadius: CGFloat(max(8, settings.messageBubbleRadius))).addClip()
+                UIColor.secondarySystemBackground.setFill()
+                context.cgContext.fill(background)
+            }
+
+            var y = horizontalPadding
+            if shotSettings.showHeaderDecorations {
+                UIColor.secondaryLabel.setFill()
+                NSString(string: "AyuGram Message Shot").draw(
+                    in: CGRect(x: horizontalPadding, y: y, width: availableWidth, height: 18.0),
+                    withAttributes: [.font: titleFont, .foregroundColor: UIColor.secondaryLabel]
+                )
+                y += headerHeight - 4.0
+            }
+
+            UIColor.label.setFill()
+            for (line, lineHeight) in measured {
+                NSString(string: line).draw(
+                    in: CGRect(x: horizontalPadding, y: y, width: availableWidth, height: lineHeight + 4.0),
+                    withAttributes: [.font: bodyFont, .foregroundColor: UIColor.label]
+                )
+                y += lineHeight + 6.0
+            }
+
+            if let reactionLine {
+                NSString(string: reactionLine).draw(
+                    in: CGRect(x: horizontalPadding, y: y, width: availableWidth, height: 22.0),
+                    withAttributes: [.font: metaFont, .foregroundColor: UIColor.secondaryLabel]
+                )
+                y += 28.0
+            }
+
+            if shotSettings.showDate {
+                NSString(string: dateText).draw(
+                    in: CGRect(x: horizontalPadding, y: height - footerHeight, width: availableWidth, height: 18.0),
+                    withAttributes: [.font: metaFont, .foregroundColor: UIColor.secondaryLabel]
+                )
+            }
+        }
+    }
+}
