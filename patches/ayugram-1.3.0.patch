+    case header(AyuSettingsSection, String)
+    case ghost(Bool)
+    case readMessages(Bool)
+    case readStories(Bool)
+    case online(Bool)
+    case uploadProgress(Bool)
+    case saveDeleted(Bool)
+    case saveEdited(Bool)
+    case filters(Bool)
+    case filtersInChats(Bool)
+    case zalgo(Bool)
+    case messageShot(Bool)
+    case seconds(Bool)
+    case removeTail(Bool)
+    case translation(TranslationProvider)
+    case bubbleRadius(Int)
+    case avatarCorners(Int)
+
+    var section: ItemListSectionId {
+        switch self {
+        case let .header(section, _):
+            return section.rawValue
+        case .ghost, .readMessages, .readStories, .online, .uploadProgress:
+            return AyuSettingsSection.privacy.rawValue
+        case .saveDeleted, .saveEdited:
+            return AyuSettingsSection.history.rawValue
+        case .filters, .filtersInChats:
+            return AyuSettingsSection.filters.rawValue
+        case .zalgo, .messageShot, .seconds, .removeTail, .translation, .bubbleRadius, .avatarCorners:
+            return AyuSettingsSection.display.rawValue
+        }
+    }
+
+    var stableId: Int32 {
+        switch self {
+        case .header(.privacy, _): return 0
+        case .ghost: return 1
+        case .readMessages: return 2
+        case .readStories: return 3
+        case .online: return 4
+        case .uploadProgress: return 5
+        case .header(.history, _): return 100
+        case .saveDeleted: return 101
+        case .saveEdited: return 102
+        case .header(.filters, _): return 200
+        case .filters: return 201
+        case .filtersInChats: return 202
+        case .header(.display, _): return 300
+        case .zalgo: return 301
+        case .messageShot: return 302
+        case .seconds: return 303
+        case .removeTail: return 304
+        case .translation: return 305
+        case .bubbleRadius: return 306
+        case .avatarCorners: return 307
+        }
+    }
+
+    static func == (lhs: AyuSettingsEntry, rhs: AyuSettingsEntry) -> Bool {
+        return lhs.stableId == rhs.stableId
+    }
+
+    static func < (lhs: AyuSettingsEntry, rhs: AyuSettingsEntry) -> Bool {
+        return lhs.stableId < rhs.stableId
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! AyuSettingsArguments
+
+        func toggle(_ title: String, _ value: Bool, _ update: @escaping (inout AyuSettings, Bool) -> Void) -> ListViewItem {
+            return ItemListSwitchItem(
+                presentationData: presentationData,
+                systemStyle: .glass,
+                title: title,
+                value: value,
+                enableInteractiveChanges: true,
+                enabled: true,
+                sectionId: self.section,
+                style: .blocks,
+                updated: { newValue in
+                    arguments.update { settings in
+                        update(&settings, newValue)
+                    }
+                }
+            )
+        }
+
+        switch self {
+        case let .header(_, title):
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: title, sectionId: self.section)
+        case let .ghost(value):
+            return toggle("Ghost Mode", value) { settings, newValue in
+                settings.updateGhostSettings(for: arguments.accountID) { ghost in
+                    ghost.setGhostModeEnabled(newValue)
+                }
+            }
+        case let .readMessages(value):
+            return toggle("Send read receipts", value) { settings, newValue in
+                settings.updateGhostSettings(for: arguments.accountID) { $0.sendReadMessages = newValue }
+            }
+        case let .readStories(value):
+            return toggle("Send story read receipts", value) { settings, newValue in
+                settings.updateGhostSettings(for: arguments.accountID) { $0.sendReadStories = newValue }
+            }
+        case let .online(value):
+            return toggle("Send online status", value) { settings, newValue in
+                settings.updateGhostSettings(for: arguments.accountID) { $0.sendOnlinePackets = newValue }
+            }
+        case let .uploadProgress(value):
+            return toggle("Send upload progress", value) { settings, newValue in
+                settings.updateGhostSettings(for: arguments.accountID) { $0.sendUploadProgress = newValue }
+            }
+        case let .saveDeleted(value):
+            return toggle("Save deleted messages", value) { $0.saveDeletedMessages = $1 }
+        case let .saveEdited(value):
+            return toggle("Save edit history", value) { $0.saveMessagesHistory = $1 }
+        case let .filters(value):
+            return toggle("Enable regex filters", value) { $0.filtersEnabled = $1 }
+        case let .filtersInChats(value):
+            return toggle("Apply filters in chats", value) { $0.filtersEnabledInChats = $1 }
+        case let .zalgo(value):
+            return toggle("Filter Zalgo / bidi controls", value) { $0.filterZalgo = $1 }
+        case let .messageShot(value):
+            return toggle("Show Message Shot", value) { $0.showMessageShot = $1 }
+        case let .seconds(value):
+            return toggle("Show seconds in shots", value) { $0.showMessageSeconds = $1 }
+        case let .removeTail(value):
+            return toggle("Remove message bubble tail", value) { $0.removeMessageTail = $1 }
+        case let .translation(value):
+            let title: String
+            switch value {
+            case .telegram: title = "Translation: Telegram"
+            case .google: title = "Translation: Google"
+            case .yandex: title = "Translation: Yandex"
+            case .native: title = "Translation: Native"
+            }
+            return ItemListActionItem(
+                presentationData: presentationData,
+                systemStyle: .glass,
+                title: title,
+                kind: .generic,
+                alignment: .natural,
+                sectionId: self.section,
+                style: .blocks,
+                action: {
+                    arguments.update { $0.translationProvider = value.next() }
+                }
+            )
+        case let .bubbleRadius(value):
+            return ItemListActionItem(
+                presentationData: presentationData,
+                systemStyle: .glass,
+                title: "Message bubble radius: (value)",
+                kind: .generic,
+                alignment: .natural,
+                sectionId: self.section,
+                style: .blocks,
+                action: {
+                    arguments.update { settings in
+                        settings.messageBubbleRadius = value >= 28 ? 8 : value + 4
+                    }
+                }
+            )
+        case let .avatarCorners(value):
+            return ItemListActionItem(
+                presentationData: presentationData,
+                systemStyle: .glass,
+                title: "Avatar corners: (value)",
+                kind: .generic,
+                alignment: .natural,
+                sectionId: self.section,
+                style: .blocks,
+                action: {
+                    arguments.update { settings in
+                        settings.avatarCorners = value >= 32 ? 8 : value + 4
+                    }
+                }
+            )
+        }
+    }
+}
+
+private enum AyuHistoryEntry: ItemListNodeEntry {
+    case header(String)
+    case item(Int64, String)
+    case empty(String)
+
+    var section: ItemListSectionId { return 0 }
+
+    var stableId: Int64 {
+        switch self {
+        case .header:
+            return 0
+        case let .item(id, _):
+            return id
+        case .empty:
+            return 1
+        }
+    }
+
+    static func == (lhs: AyuHistoryEntry, rhs: AyuHistoryEntry) -> Bool {
+        switch (lhs, rhs) {
+        case let (.header(a), .header(b)):
+            return a == b
+        case let (.item(aId, a), .item(bId, b)):
+            return aId == bId && a == b
+        case let (.empty(a), .empty(b)):
+            return a == b
+        default:
+            return false
+        }
+    }
+
+    static func < (lhs: AyuHistoryEntry, rhs: AyuHistoryEntry) -> Bool {
+        return lhs.stableId < rhs.stableId
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        switch self {
+        case let .header(text):
+            return ItemListSectionHeaderItem(presentationData: presentationData, text: text, sectionId: self.section)
+        case let .item(_, text), let .empty(text):
+            return ItemListTextItem(presentationData: presentationData, text: .plain(text), sectionId: self.section)
+        }
+    }
+}
+
+private final class AyuSettingsArguments {
+    let accountID: Int64
+    let context: AccountContext
+    var settings: AyuSettings
+    let statePromise: ValuePromise<AyuSettings>
+
+    init(context: AccountContext, settings: AyuSettings) {
+        self.context = context
+        self.accountID = context.account.peerId.toInt64()
+        self.settings = settings
+        self.statePromise = ValuePromise(settings, ignoreRepeated: true)
+    }
+
+    func update(_ body: (inout AyuSettings) -> Void) {
+        var next = self.settings
+        body(&next)
+        self.settings = next
+        _ = try? AyuGramRuntime.cachedSettingsStore(accountID: self.accountID).update { $0 = next }
+        self.statePromise.set(next)
+    }
+}
+
+private func ayuSettingsEntries(_ settings: AyuSettings, accountID: Int64) -> [AyuSettingsEntry] {
+    let ghost = settings.ghostSettings(for: accountID)
+    return [
+        .header(.privacy, "Privacy"),
+        .ghost(ghost.isGhostModeActive),
+        .readMessages(ghost.sendReadMessages),
+        .readStories(ghost.sendReadStories),
+        .online(ghost.sendOnlinePackets),
+        .uploadProgress(ghost.sendUploadProgress),
+        .header(.history, "Message History"),
+        .saveDeleted(settings.saveDeletedMessages),
+        .saveEdited(settings.saveMessagesHistory),
+        .header(.filters, "Filters"),
+        .filters(settings.filtersEnabled),
+        .filtersInChats(settings.filtersEnabledInChats),
+        .header(.display, "Display & Translation"),
+        .zalgo(settings.filterZalgo),
+        .messageShot(settings.showMessageShot),
+        .seconds(settings.showMessageSeconds),
+        .removeTail(settings.removeMessageTail),
+        .translation(settings.translationProvider),
+        .bubbleRadius(settings.messageBubbleRadius),
+        .avatarCorners(settings.avatarCorners)
+    ]
+}
+
+public func ayuGramSettingsScreen(context: AccountContext) -> ViewController {
+    let settings = AyuGramRuntime.settings(accountID: context.account.peerId.toInt64()) ?? AyuSettings()
+    let arguments = AyuSettingsArguments(context: context, settings: settings)
+
+    let signal = combineLatest(context.sharedContext.presentationData, arguments.statePromise.get())
+    |> deliverOnMainQueue
+    |> map { presentationData, state -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let controllerState = ItemListControllerState(
+            presentationData: ItemListPresentationData(presentationData),
+            title: .text("AyuGram"),
+            leftNavigationButton: nil,
+            rightNavigationButton: nil,
+            backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back),
+            animateChanges: true
+        )
+        let listState = ItemListNodeState(
+            presentationData: ItemListPresentationData(presentationData),
+            entries: ayuSettingsEntries(state, accountID: arguments.accountID),
+            style: .blocks,
+            animateChanges: true
+        )
+        return (controllerState, (listState, arguments))
+    }
+
+    return ItemListController(context: context, state: signal)
+}
+
+private func ayuHistoryEntries(_ messages: [AyuMessage]) -> [AyuHistoryEntry] {
+    guard !messages.isEmpty else {
+        return [.header("AyuGram History"), .empty("No deleted or edited messages yet.")]
+    }
+
+    let formatter = DateFormatter()
+    formatter.dateStyle = .medium
+    formatter.timeStyle = .short
+
+    var entries: [AyuHistoryEntry] = [.header("AyuGram History")]
+    for message in messages.sorted(by: { $0.fakeID > $1.fakeID }) {
+        let kind = message.isDeleted ? "🧹 Deleted" : "✏️ Edited"
+        let date = formatter.string(from: Date(timeIntervalSince1970: TimeInterval(message.date)))
+        let mediaLabel: String
+        if let mimeType = message.mimeType, !mimeType.isEmpty {
+            mediaLabel = " [(mimeType)]"
+        } else {
+            mediaLabel = ""
+        }
+        let body = message.text.isEmpty ? "(media)(mediaLabel)" : message.text
+        entries.append(.item(message.fakeID, "(kind) • (date)(mediaLabel)
+(body)"))
+    }
+    return entries
+}
+
+public func ayuGramHistoryScreen(context: AccountContext, dialogID: Int64? = nil) -> ViewController {
+    let accountID = context.account.peerId.toInt64()
+
+    let signal = combineLatest(
+        context.sharedContext.presentationData,
+        context.account.postbox.transaction { transaction in
+            AyuGramPostboxHistoryStore.filtered(
+                transaction: transaction,
+                userID: accountID,
+                dialogID: dialogID,
+                kind: .all,
+                limit: 500
+            )
+        }
+    )
+    |> deliverOnMainQueue
+    |> map { presentationData, messages -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let title = dialogID == nil ? "AyuGram History" : "Group History"
+        let controllerState = ItemListControllerState(
+            presentationData: ItemListPresentationData(presentationData),
+            title: .text(title),
+            leftNavigationButton: nil,
+            rightNavigationButton: nil,
+            backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back),
+            animateChanges: false
+        )
+        let listState = ItemListNodeState(
+            presentationData: ItemListPresentationData(presentationData),
+            entries: ayuHistoryEntries(messages),
+            style: .blocks,
+            animateChanges: false
+        )
+        return (controllerState, (listState, NSNull()))
+    }
+
+    return ItemListController(context: context, state: signal)
+}
+
+public func ayuGramFiltersScreen(context: AccountContext) -> ViewController {
+    return ayuGramSettingsScreen(context: context)
+}
