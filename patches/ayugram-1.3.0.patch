diff --git a/submodules/AyuGramIOS/Sources/AyuSettingsStore.swift b/submodules/AyuGramIOS/Sources/AyuSettingsStore.swift
new file mode 100644
--- /dev/null
+++ b/submodules/AyuGramIOS/Sources/AyuSettingsStore.swift
@@ -0,0 +1,46 @@
+import Foundation
+
+public final class AyuSettingsStore: @unchecked Sendable {
+    public let url: URL
+    private let encoder: JSONEncoder
+    private let decoder: JSONDecoder
+    private let lock = NSLock()
+    private var cached: AyuSettings
+
+    public init(url: URL, initial: AyuSettings = AyuSettings()) throws {
+        self.url = url
+        self.encoder = JSONEncoder()
+        self.decoder = JSONDecoder()
+        if FileManager.default.fileExists(atPath: url.path) {
+            let data = try Data(contentsOf: url)
+            self.cached = try decoder.decode(AyuSettings.self, from: data)
+        } else {
+            self.cached = initial
+            try persist(initial)
+        }
+    }
+
+    public var settings: AyuSettings {
+        lock.lock(); defer { lock.unlock() }
+        return cached
+    }
+
+    public func update(_ body: (inout AyuSettings) -> Void) throws {
+        lock.lock(); defer { lock.unlock() }
+        body(&cached)
+        try persist(cached)
+    }
+
+    public func reset() throws {
+        lock.lock(); defer { lock.unlock() }
+        cached = AyuSettings()
+        try persist(cached)
+    }
+
+    private func persist(_ settings: AyuSettings) throws {
+        let dir = url.deletingLastPathComponent()
+        try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
+        let data = try encoder.encode(settings)
+        try data.write(to: url, options: .atomic)
+    }
+}
diff --git a/submodules/AyuGramIOS/Sources/AyuTextSanitizer.swift b/submodules/AyuGramIOS/Sources/AyuTextSanitizer.swift
new file mode 100644
--- /dev/null
+++ b/submodules/AyuGramIOS/Sources/AyuTextSanitizer.swift
@@ -0,0 +1,38 @@
+import Foundation
+
+public enum AyuTextSanitizer {
+    private static let pattern = "\\p{Mn}{3,}|[\\x{202A}-\\x{202E}\\x{2066}-\\x{2069}\\x{200E}\\x{200F}\\x{061C}]"
+
+    public static func filterZalgo(_ text: String) -> String {
+        guard !text.isEmpty, let regex = try? NSRegularExpression(pattern: pattern) else {
+            return text
+        }
+        let fullRange = NSRange(text.startIndex..<text.endIndex, in: text)
+        guard regex.firstMatch(in: text, range: fullRange) != nil else {
+            return text
+        }
+
+        // Work in UTF-16 ranges because NSRegularExpression reports UTF-16 offsets.
+        // Converting prefixes back to String through NSString avoids splitting a Swift
+        // grapheme cluster (e.g. base character + combining marks).
+        let nsText = text as NSString
+        var output = ""
+        output.reserveCapacity(text.utf8.count)
+        var lastEnd = 0
+
+        for match in regex.matches(in: text, range: fullRange) {
+            let start = match.range.location
+            let end = start + match.range.length
+            if start > lastEnd {
+                output.append(nsText.substring(with: NSRange(location: lastEnd, length: start - lastEnd)))
+            }
+            output.append(String(repeating: "\u{2060}", count: max(1, match.range.length)))
+            lastEnd = end
+        }
+
+        if lastEnd < nsText.length {
+            output.append(nsText.substring(with: NSRange(location: lastEnd, length: nsText.length - lastEnd)))
+        }
+        return output
+    }
+}
diff --git a/submodules/AyuGramIOS/Sources/GhostMode.swift b/submodules/AyuGramIOS/Sources/GhostMode.swift
new file mode 100644
--- /dev/null
+++ b/submodules/AyuGramIOS/Sources/GhostMode.swift
@@ -0,0 +1,101 @@
+import Foundation
+
+/// Mirrors AyuGram Desktop's GhostModeAccountSettings semantics from v7.0.9.
+/// Network integration is intentionally separated from this policy object.
+public struct GhostModeSettings: Codable, Equatable, Sendable {
+    public enum SendWithoutSoundOption: Int, Codable, Sendable {
+        case never = 0
+        case inGhostMode = 1
+        case always = 2
+    }
+
+    public var sendReadMessages: Bool = true
+    public var sendReadStories: Bool = true
+    public var sendOnlinePackets: Bool = true
+    public var sendUploadProgress: Bool = true
+    public var sendOfflinePacketAfterOnline: Bool = false
+    public var markReadAfterAction: Bool = true
+    public var useScheduledMessages: Bool = false
+    public var sendWithoutSound: SendWithoutSoundOption = .never
+    public var suggestGhostModeBeforeViewingStory: Bool = true
+
+    public var sendReadMessagesLocked: Bool = false
+    public var sendReadStoriesLocked: Bool = false
+    public var sendOnlinePacketsLocked: Bool = false
+    public var sendUploadProgressLocked: Bool = false
+    public var sendOfflinePacketAfterOnlineLocked: Bool = false
+
+    public init() {}
+
+    public var isGhostModeActive: Bool {
+        (sendReadMessagesLocked || !sendReadMessages)
+        && (sendReadStoriesLocked || !sendReadStories)
+        && (sendOnlinePacketsLocked || !sendOnlinePackets)
+        && (sendUploadProgressLocked || !sendUploadProgress)
+        && (sendOfflinePacketAfterOnlineLocked || sendOfflinePacketAfterOnline)
+    }
+
+    public var shouldSendWithoutSound: Bool {
+        switch sendWithoutSound {
+        case .never: return false
+        case .inGhostMode: return isGhostModeActive
+        case .always: return true
+        }
+    }
+
+    /// Mirrors Desktop's bulk toggle, respecting locked fields.
+    public mutating func setGhostModeEnabled(_ enabled: Bool) {
+        if !sendReadMessagesLocked { sendReadMessages = !enabled }
+        if !sendReadStoriesLocked { sendReadStories = !enabled }
+        if !sendOnlinePacketsLocked { sendOnlinePackets = !enabled }
+        if !sendUploadProgressLocked { sendUploadProgress = !enabled }
+        if !sendOfflinePacketAfterOnlineLocked { sendOfflinePacketAfterOnline = enabled }
+    }
+}
+
+public enum AyuPacketKind: String, Codable, Sendable {
+    case readMessages
+    case readStories
+    case onlineStatus
+    case uploadProgress
+    case offlineStatus
+}
+
+/// A pure policy layer. Telegram-iOS integration should ask this object before
+/// dispatching a packet/request instead of embedding Ayu logic in UI code.
+public struct GhostModePolicy: Sendable {
+    public let settings: GhostModeSettings
+
+    public init(settings: GhostModeSettings) {
+        self.settings = settings
+    }
+
+    public func shouldSend(_ kind: AyuPacketKind) -> Bool {
+        switch kind {
+        case .readMessages: return settings.sendReadMessages
+        case .readStories: return settings.sendReadStories
+        case .onlineStatus: return settings.sendOnlinePackets
+        case .uploadProgress: return settings.sendUploadProgress
+        case .offlineStatus: return settings.sendOfflinePacketAfterOnline
+        }
+    }
+
+    public func apply<T>(_ kind: AyuPacketKind, send: () throws -> T) rethrows -> T? {
+        guard shouldSend(kind) else { return nil }
+        return try send()
+    }
+}
+
+public enum AyuGramGhostGate {
+    /// Fast read-only lookup used from TelegramCore network paths.
+    public static func shouldSend(_ kind: AyuPacketKind, accountID: Int64) -> Bool {
+        guard let settings = AyuGramRuntime.settings(accountID: accountID) else {
+            return true
+        }
+        return GhostModePolicy(settings: settings.ghostSettings(for: accountID)).shouldSend(kind)
+    }
+
+    public static func settings(accountID: Int64) -> GhostModeSettings {
+        return AyuGramRuntime.settings(accountID: accountID)?.ghostSettings(for: accountID) ?? GhostModeSettings()
+    }
+}
diff --git a/submodules/AyuGramIOS/Sources/MessageHistory.swift b/submodules/AyuGramIOS/Sources/MessageHistory.swift
new file mode 100644
--- /dev/null
+++ b/submodules/AyuGramIOS/Sources/MessageHistory.swift
@@ -0,0 +1,178 @@
+import Foundation
+
+
+public enum AyuHistoryKind: String, Codable, Sendable {
+    case all
+    case deleted
+    case edited
+}
+
+public struct AyuMessage: Codable, Identifiable, Equatable, Sendable {
+    public let fakeID: Int64
+    public let userID: Int64
+    public let dialogID: Int64
+    public let peerID: Int64
+    public let fromID: Int64
+    public let topicID: Int64
+    public let messageID: Int32
+    public let date: Int32
+    public let editDate: Int32
+    public let text: String
+    public let mediaPath: String?
+    public let mimeType: String?
+    public let isDeleted: Bool
+
+    public var id: Int64 { fakeID }
+
+    public init(
+        fakeID: Int64,
+        userID: Int64,
+        dialogID: Int64,
+        peerID: Int64,
+        fromID: Int64,
+        topicID: Int64 = 0,
+        messageID: Int32,
+        date: Int32,
+        editDate: Int32 = 0,
+        text: String,
+        mediaPath: String? = nil,
+        mimeType: String? = nil,
+        isDeleted: Bool
+    ) {
+        self.fakeID = fakeID
+        self.userID = userID
+        self.dialogID = dialogID
+        self.peerID = peerID
+        self.fromID = fromID
+        self.topicID = topicID
+        self.messageID = messageID
+        self.date = date
+        self.editDate = editDate
+        self.text = text
+        self.mediaPath = mediaPath
+        self.mimeType = mimeType
+        self.isDeleted = isDeleted
+    }
+}
+
+/// Portable first implementation of AyuGram's local message-history layer.
+/// The production Telegram-iOS integration can swap this backing store for
+/// Postbox/SQLite without changing the public API.
+public actor MessageHistoryStore {
+    private let url: URL
+    private var messages: [AyuMessage]
+    private var nextFakeID: Int64
+
+    public init(url: URL) throws {
+        self.url = url
+        if FileManager.default.fileExists(atPath: url.path) {
+            let data = try Data(contentsOf: url)
+            self.messages = try JSONDecoder().decode([AyuMessage].self, from: data)
+        } else {
+            self.messages = []
+        }
+        self.nextFakeID = (messages.map(\.fakeID).max() ?? 0) + 1
+    }
+
+    @discardableResult
+    public func addDeleted(_ message: AyuMessage) async throws -> AyuMessage {
+        try add(Self.mark(message, deleted: true))
+    }
+
+    @discardableResult
+    public func addEdited(_ message: AyuMessage) async throws -> AyuMessage {
+        try add(Self.mark(message, deleted: false))
+    }
+
+    public func revisions(userID: Int64, dialogID: Int64, messageID: Int32, limit: Int = 100) -> [AyuMessage] {
+        Array(messages.filter { !$0.isDeleted && $0.userID == userID && $0.dialogID == dialogID && $0.messageID == messageID }
+            .sorted { $0.fakeID > $1.fakeID }
+            .prefix(max(0, limit)))
+    }
+
+    public func deleted(userID: Int64, dialogID: Int64, topicID: Int64 = 0, query: String? = nil, limit: Int = 100) -> [AyuMessage] {
+        let normalizedQuery = query?.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
+        return Array(messages.filter {
+            guard $0.isDeleted, $0.userID == userID, $0.dialogID == dialogID else { return false }
+            guard topicID == 0 || $0.topicID == topicID else { return false }
+            if let q = normalizedQuery, !q.isEmpty { return $0.text.lowercased().contains(q) }
+            return true
+        }.sorted { $0.messageID > $1.messageID }.prefix(max(0, limit)))
+    }
+
+    public func all(limit: Int = 500) -> [AyuMessage] {
+        Array(messages.sorted { $0.fakeID > $1.fakeID }.prefix(max(0, limit)))
+    }
+
+    public func hasDeleted(userID: Int64, dialogID: Int64, topicID: Int64 = 0) -> Bool {
+        messages.contains {
+            $0.isDeleted && $0.userID == userID && $0.dialogID == dialogID
+            && (topicID == 0 || $0.topicID == topicID)
+        }
+    }
+
+    public func hasRevisions(userID: Int64, dialogID: Int64, messageID: Int32) -> Bool {
+        messages.contains {
+            !$0.isDeleted && $0.userID == userID && $0.dialogID == dialogID && $0.messageID == messageID
+        }
+    }
+
+    public func clearDeleted(userID: Int64, dialogID: Int64, topicID: Int64 = 0) async throws {
+        messages.removeAll {
+            $0.isDeleted && $0.userID == userID && $0.dialogID == dialogID
+            && (topicID == 0 || $0.topicID == topicID)
+        }
+        try persist()
+    }
+
+    public func clearAll() async throws {
+        messages.removeAll()
+        try persist()
+    }
+
+    private func add(_ message: AyuMessage) throws -> AyuMessage {
+        let stored = AyuMessage(
+            fakeID: nextFakeID,
+            userID: message.userID,
+            dialogID: message.dialogID,
+            peerID: message.peerID,
+            fromID: message.fromID,
+            topicID: message.topicID,
+            messageID: message.messageID,
+            date: message.date,
+            editDate: message.editDate,
+            text: message.text,
+            mediaPath: message.mediaPath,
+            mimeType: message.mimeType,
+            isDeleted: message.isDeleted
+        )
+        nextFakeID += 1
+        messages.append(stored)
+        try persist()
+        return stored
+    }
+
+    private func persist() throws {
+        let dir = url.deletingLastPathComponent()
+        try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
+        try JSONEncoder().encode(messages).write(to: url, options: .atomic)
+    }
+
+    private static func mark(_ message: AyuMessage, deleted: Bool) -> AyuMessage {
+        AyuMessage(
+            fakeID: 0,
+            userID: message.userID,
+            dialogID: message.dialogID,
+            peerID: message.peerID,
+            fromID: message.fromID,
+            topicID: message.topicID,
+            messageID: message.messageID,
+            date: message.date,
+            editDate: message.editDate,
+            text: message.text,
+            mediaPath: message.mediaPath,
+            mimeType: message.mimeType,
+            isDeleted: deleted
+        )
+    }
+}
